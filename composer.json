{
    "name": "jkossen/capo",
    "license": "GPL-3.0+",
    "type": "project",
    "description": "Webbased frontend and API for multiple Cacti instances",
    "autoload": {
        "psr-4": { "": "src/", "SymfonyStandard\\": "app/" }
    },
    "require": {
        "php": "7.4.*",
        "symfony/symfony": "2.8.*",
        "doctrine/orm": "~2.5.14",
        "doctrine/inflector": "~1.3.0",
        "doctrine/doctrine-bundle": "~1.10.0",
        "doctrine/doctrine-fixtures-bundle": "~2.4",
        "symfony/assetic-bundle": "~2.8",
        "symfony/swiftmailer-bundle": "~2.6",
        "symfony/monolog-bundle": "~2.12",
        "symfony/var-dumper": "^2.8",
        "twig/twig": "^2.12",
        "sensio/distribution-bundle": "~4.0",
        "sensio/framework-extra-bundle": "~3.0,>=3.0.29",
        "incenteev/composer-parameter-handler": "~2.1",
        "friendsofsymfony/user-bundle": "~2.1.0",
        "escapestudios/wsse-authentication-bundle": "~2.3",
        "fr3d/ldap-bundle": "~3.0.2",
        "components/jquery": "1.11.*",
        "components/underscore": "dev-master",
        "setasign/fpdf": "1.8.2",
        "ivaynberg/select2": ">=3.5.1,<3.6.0",
        "spinjs/spinjs": "2.0.1",
        "select2-bootstrap/select2-bootstrap": "1.4.4",
        "jscrolljs/jscrolljs": "2.2.4",
        "components/bootstrap": "^3.3",
        "composer/installers": "^2.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "guzzlehttp/guzzle": "^6.5"
    },
    "replace": {
        "robloach/component-installer": "*"
    },
    "require-dev": {
        "sensio/generator-bundle": "~2.5",
        "phpunit/phpunit": "~7.5",
        "ext-pdo_sqlite": "*",
        "symfony/phpunit-bridge": "^4.4"
    },
    "scripts": {
        "post-root-package-install": [
            "SymfonyStandard\\Composer::hookRootPackageInstall"
        ],
        "build-bootstrap": [
            "@php vendor/sensio/distribution-bundle/Sensio/Bundle/DistributionBundle/Resources/bin/build_bootstrap.php app app"
        ],
        "clear-cache": [
            "@php app/console cache:clear --no-warmup"
        ],
        "install-assets": [
            "@php app/console assets:install --relative web"
        ],
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@build-bootstrap",
            "@clear-cache",
            "@install-assets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::prepareDeploymentTarget"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@build-bootstrap",
            "@clear-cache",
            "@install-assets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::prepareDeploymentTarget"
        ]
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true,
            "cweagans/composer-patches": true,
            "robloach/component-installer": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-web-dir": "web",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        },
        "branch-alias": {
            "dev-master": "2.7-dev"
        },
        "installer-types": [
            "component"
        ],
        "installer-paths": {
            "web/components/{$name}/": [
                "type:component"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "doctrine/orm": {
                "PHP 7.4 compatibility (backported from doctrine/orm 2.7)": "patches/doctrine-orm-2.5-php74.patch"
            },
            "doctrine/common": {
                "PHP 7.4 compatibility (backported from doctrine/common 2.10)": "patches/doctrine-common-2.8-php74.patch"
            },
            "kriswallsmith/assetic": {
                "Use the Twig 2 class names": "patches/assetic-1.4-twig2-class-names.patch"
            }
        }
    },
    "repositories": [
    {
            "type": "package",
            "package": {
            "version": "3.3.4",
            "name": "twitter/bootstrap",
            "dist": {
                "url": "https://github.com/twbs/bootstrap/releases/download/v3.3.4/bootstrap-3.3.4-dist.zip",
                "type": "zip"
            }
        }
    },
    {
        "type": "package",
        "package": {
            "name": "spinjs/spinjs",
            "version": "2.0.1",
            "dist": {
                "url": "https://raw.githubusercontent.com/fgnass/spin.js/8cc98bc0b5bb519a8916064c0704dbfd61c2fd66/spin.js",
                "type": "file"
            }
        }
    },
    {
        "type": "package",
        "package": {
            "name": "select2-bootstrap/select2-bootstrap",
            "version": "1.4.4",
            "dist": {
                "url": "https://raw.githubusercontent.com/t0m/select2-bootstrap-css/ddce1a12eea333b28069df1e2e63db146a01a69e/select2-bootstrap.css",
                "type": "file"
            }
        }
    },
    {
        "type": "package",
        "package": {
            "name": "jscrolljs/jscrolljs",
            "version": "2.2.4",
            "dist": {
                "url": "https://raw.githubusercontent.com/pklauzinski/jscroll/bc31cbb71f92c310c77cc0656d2847b3bd260b29/jquery.jscroll.js",
                "type": "file"
            }
        }
    }]
}
